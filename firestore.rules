rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidMovieData(data) {
      return data.title is string && data.title.size() > 0 &&
             data.thumbnail is string && data.thumbnail.size() > 0 &&
             data.video_url is string && data.video_url.size() > 0;
    }

    // Movies collection
    match /movies/{movieId} {
      // Publicly readable so visitors and community members can stream movies
      allow read: if true;
      // Allow creation of valid movies
      allow create: if isValidMovieData(request.resource.data);
      // Allow updates to views count or by uploader
      allow update: if true;
      // Allow delete if requested
      allow delete: if request.auth != null;
    }
  }
}
